{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@ngj/shared": ["../../packages/shared/src/index.ts"],
      "@ngj/shared/types": ["../../packages/shared/src/types.ts"],
      "@ngj/shared/paths": ["../../packages/shared/src/paths.ts"],
      "@ngj/shared/validation": ["../../packages/shared/src/validation.ts"],
      "@ngj/shared/*": ["../../packages/shared/src/*"],
      "@renderer": ["src/renderer"],
      "@renderer/*": ["src/renderer/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "out", "release"]
}
