{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@ngj/shared": ["../../packages/shared/src/index.ts"],
      "@ngj/shared/types": ["../../packages/shared/src/types.ts"],
      "@ngj/shared/paths": ["../../packages/shared/src/paths.ts"],
      "@ngj/shared/validation": ["../../packages/shared/src/validation.ts"],
      "@ngj/shared/*": ["../../packages/shared/src/*"],
      "@ngj/server": ["../../packages/server/src/index.ts"],
      "@ngj/server/*": ["../../packages/server/src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
