{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NginxJump",
  "version": "1.0.0",
  "identifier": "com.nginx-jump-gui.app",
  "build": {
    "beforeBuildCommand": "node scripts/build-app.mjs --resources",
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../build/app/server.cjs": "server/server.cjs",
      "../../build/node/node.exe": "bin/node.exe",
      "../../resources/nginx": "nginx/",
      "../../build/app/templates": "templates/",
      "../../build/app/better_sqlite3.win32.node": "server/better_sqlite3.node",
      "../../apps/web/dist": "web-dist/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Nginx 跳板机",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
