{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": "..",
    "paths": {
      "@ngj/shared": ["shared/src/index.ts"],
      "@ngj/shared/*": ["shared/src/*"]
    }
  },
  "include": ["src"]
}
