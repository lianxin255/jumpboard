{
  "name": "nginx-jump-gui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "内网跳板机 nginx 管理软件 · Tauri 桌面壳 + Node sidecar 后端",
  "scripts": {
    "dev:web": "pnpm -F @ngj/web dev",
    "dev:server": "pnpm -F @ngj/server dev",
    "server": "pnpm -F @ngj/server start",
    "build": "pnpm run -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "test:web": "vitest run --project web",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "pnpm -r typecheck",
    "tauri": "tauri",
    "app:build": "node scripts/build-app.mjs",
    "app:build:resources": "node scripts/build-app.mjs --resources",
    "prepare": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@tauri-apps/cli": "catalog:dev",
    "esbuild": "catalog:dev",
    "jsdom": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "vue": "catalog:frontend"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}