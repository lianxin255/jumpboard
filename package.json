{
  "name": "nginx-jump-gui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "内网跳板机 nginx 管理软件 · Electron 桌面壳 + Node 后端",
  "scripts": {
    "dev": "pnpm -F @ngj/desktop dev",
    "dev:web": "pnpm -F @ngj/web dev",
    "dev:server": "pnpm -F @ngj/server dev",
    "server": "pnpm -F @ngj/server start",
    "build": "pnpm run -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-desktop.mjs --current --dir && vitest run --config vitest.e2e.config.ts",
    "build:desktop:dir": "node scripts/build-desktop.mjs --current --dir",
    "test:server": "vitest run --project server",
    "test:web": "vitest run --project web",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "pnpm -r typecheck",
    "build:win:dir": "node scripts/build-desktop.mjs --win --dir",
    "build:win": "node scripts/build-desktop.mjs --win portable",
    "build:mac:dir": "node scripts/build-desktop.mjs --mac --dir",
    "build:mac": "node scripts/build-desktop.mjs --mac dmg"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@electron/rebuild": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "jsdom": "catalog:dev",
    "playwright-core": "^1.63.0",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:frontend"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
