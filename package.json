{
  "name": "nginx-jump-gui",
  "version": "1.0.0",
  "description": "内网跳板机 nginx 管理软件",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build:portable": "electron-vite build && electron-builder --win portable",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@antdv-next/icons": "^1.1.1",
    "@v-c/util": "^1.0.21",
    "antdv-next": "^1.4.3",
    "antdv-style": "^0.1.0-alpha.1",
    "better-sqlite3": "^11.0.0",
    "fs-extra": "^11.3.6",
    "pinia": "^2.2.0",
    "ssh2": "^1.17.0",
    "vue": "^3.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.1.0",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.1.0",
    "typescript": "^5.4.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
